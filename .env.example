# ---------------------------------------------------------------------------
# Uber Ads API example — configuration
#
# Copy this file to `.env.local` and fill in your own values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# Required. Create an app at https://developer.uber.com/dashboard and copy its
# credentials here. The secret is only ever read server-side.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional — sensible defaults are applied when these are unset.
# ---------------------------------------------------------------------------

# Public origin of this app. Used to derive the OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must match the redirect URI registered on your Uber app *exactly*.
# Defaults to ${NEXT_PUBLIC_APP_URL}/auth/callback.
# UBER_REDIRECT_URI=http://localhost:3000/auth/callback

# Space-separated OAuth scopes. Defaults to all six Ads API scopes:
#   ads.ad-accounts.read ads.campaigns.read ads.campaigns.write
#   ads.products.read ads.reporting ads.sync.reporting
# Sync and async reporting are gated behind different scopes: /reporting/sync
# needs ads.sync.reporting, the async job endpoints need ads.reporting.
# Narrow this if your app is only approved for a subset.
# UBER_SCOPES=ads.ad-accounts.read ads.campaigns.read ads.reporting

# API hosts. Override only if Uber directs you to a different environment.
# UBER_AUTH_BASE_URL=https://auth.uber.com
# UBER_API_BASE_URL=https://api.uber.com
