{
  "name": "uber-ads-api-example",
  "version": "1.0.0",
  "private": true,
  "description": "A runnable example app for the Uber Ads API: OAuth, campaigns, ad groups, ads, catalog, and reporting.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript openapi/uber-ads.json -o types/uber-ads.ts",
    "update:spec": "curl -fsSL -A Mozilla/5.0 https://developer.uber.com/integration-resources/ads/openapi.json -o openapi/uber-ads.json && npm run generate:types"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "next": "^15.5.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8",
    "typescript": "^5"
  }
}
